{
  "name": "scherhak/laravel-uplinkr",
  "type": "library",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^12.0",
    "illuminate/console": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Uplinkr\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Uplinkr\\UplinkrServiceProvider"
      ]
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Uplinkr\\Tests\\": "tests/"
    }
  }
}
