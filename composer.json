{
  "name": "scherhak/uplinkr",
  "description": "A lightweight, file-based Laravel package for monitoring website availability with zero external dependencies.",
  "keywords": [
    "laravel",
    "monitoring",
    "uptime",
    "url",
    "probe",
    "status",
    "filesystem"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://uplinkr.dev",
  "authors": [
    {
      "name": "Sascha Scherhak",
      "email": "sascha@uplinkr.dev"
    }
  ],
  "support": {
    "source": "https://github.com/scherhak/uplinkr",
    "issues": "https://github.com/scherhak/uplinkr/issues",
    "docs": "https://uplinkr.dev/docs"
  },
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/console": "^11.0|^12.0"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Uplinkr\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Uplinkr\\UplinkrServiceProvider"
      ]
    }
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Uplinkr\\Tests\\": "tests/"
    }
  }
}
